# Port the server listens on
PORT=3000
# Max JSON request body size (DoS protection while hashing)
BODY_LIMIT=1mb
# Default key algorithm for /api/keys/generate: rsa | ed25519
DEFAULT_KEY_ALGORITHM=rsa
# RSA modulus length in bits (minimum 2048, 4096 recommended for production)
RSA_MODULUS_LENGTH=2048
